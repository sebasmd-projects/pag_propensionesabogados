"Client %(name)s created. They will enter the portal with their "
"identification number and a code sent to %(email)s."
msgstr ""
"Cliente %(name)s creado. Entrará al portal con su número de identificación y"
" un código que le enviaremos a %(email)s."

#: gestor.py:241
#, python-format
msgid ""
"Client %(name)s created, but without an email address they cannot use the "
