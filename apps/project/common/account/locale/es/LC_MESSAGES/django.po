msgstr "Control de bonos históricos"

#: .\templates\two_factor\_wizard_actions.html:13
msgid "Next"
msgstr "Siguiente"

#: .\templates\two_factor\_wizard_actions.html:19
msgid "Back"
msgstr "Atrás"

#: .\templates\two_factor\_wizard_actions.html:23
msgid "Cancel"
msgstr "Cancelar"

#: .\templates\two_factor\core\login.html:59
msgid ""
"Too many failed attempts from this connection. Please wait a few minutes "
"before trying again."
msgstr ""
"Demasiados intentos fallidos desde esta conexión. Espera unos minutos antes "
"de volver a intentarlo."

#: .\templates\two_factor\core\login.html:106
msgid "Show or hide the password"
msgstr "Mostrar u ocultar la contraseña"

#: .\templates\two_factor\core\login.html:116
msgid "Forgot your password?"
msgstr "¿Olvidaste tu contraseña?"

#: .\templates\two_factor\core\login.html:150
msgid "Resend"
msgstr "Reenviar"

#: .\templates\two_factor\core\login.html:150
msgid "Send code"
msgstr "Enviar código"

#: .\templates\two_factor\core\login.html:167
msgid "A one-time code has been sent to your email"
msgstr "Hemos enviado un código de un solo uso a tu correo"

#: .\templates\two_factor\core\login.html:170
msgid ""
"After several failed password attempts we sent you a code so you can sign in"
" without getting locked out."
msgstr ""
"Tras varios intentos fallidos con la contraseña te hemos enviado un código "
"para que puedas entrar sin quedarte bloqueado."

#: .\templates\two_factor\core\login.html:180
msgid ""
"Enter your username or email and press «Send code». The code will arrive at "
"the email address on your account."
msgstr ""
"Escribe tu usuario o tu correo y pulsa «Enviar código». El código llegará a "
"la dirección de correo de tu cuenta."

#: .\templates\two_factor\core\login.html:198
#, python-format
msgid "The code expires in %(minutes)s minutes."
msgstr "El código caduca en %(minutes)s minutos."

#: .\templates\two_factor\core\login.html:212
msgid "Sign in with my password instead"
msgstr "Prefiero entrar con mi contraseña"

#: .\templates\two_factor\core\login.html:228
msgid "Verify"
msgstr "Verificar"

#: .\templates\two_factor\core\login.html:234
msgid "Or, alternatively, use one of your other authentication methods:"
msgstr "O bien usa otro de tus métodos de autenticación:"

#: .\templates\two_factor\core\login.html:250
msgid "Use a backup token"
msgstr "Usar un código de respaldo"

#: .\templates\two_factor\core\login.html:268
msgid "New user?"
msgstr "¿Eres nuevo?"

#: .\templates\two_factor\core\login.html:270
msgid "Create an account"
msgstr "Crea una cuenta"

#: .\views.py:172 .\views.py:200
#| msgid "Confirm Password"
msgid "Reset Your Password"
msgstr "Restablece tu contraseña"

#: .\views.py:185
#| msgid "User or Email"
msgid "Check Your Email"
msgstr "Revisa tu correo"

#: .\views.py:187
msgid ""
"If an account exists with the provided email/username, you will receive "
"password reset instructions shortly."
msgstr ""
"Si existe una cuenta con el correo o usuario indicado, recibirás en breve "
"las instrucciones para restablecer tu contraseña."

#: .\views.py:285
#| msgid "The code is not valid or has expired. Request a new one."
msgid ""
"The password reset link is invalid or has expired. Please request a new "
"password reset."
msgstr ""
"El enlace para restablecer la contraseña no es válido o ha caducado. "
"Solicita uno nuevo."

#: .\views.py:302 .\views.py:317
#| msgid "Password"
msgid "Set New Password"
msgstr "Fijar una contraseña nueva"

#: .\views.py:330
msgid ""
"Your password has been reset successfully. You can now log in with your new "
"password."
msgstr ""
"Tu contraseña se ha restablecido. Ya puedes iniciar sesión con la nueva."

#: .\views.py:352
msgid "You must be logged in to change your password."
msgstr "Debes iniciar sesión para cambiar tu contraseña."

#: .\views.py:378
msgid "Your password has been changed successfully!"
msgstr "Tu contraseña se ha cambiado correctamente."

