#: .\templates\account\email\password_reset.html:17
#: .\templates\account\email\password_reset.html:42
msgid "Reset your password"
msgstr "Restablece tu contraseña"

#: .\templates\account\email\password_reset.html:50
#, python-format
msgid "Dear %(name)s,"
msgstr "Hola, %(name)s:"

#: .\templates\account\email\password_reset.html:53
msgid ""
"We received a request to set a new password for your account. Use the button"
" below to choose it."
msgstr ""
"Hemos recibido una solicitud para fijar una contraseña nueva en tu cuenta. "
"Usa el botón para elegirla."

#: .\templates\account\email\password_reset.html:63
#| msgid "Show or hide the password"
msgid "Choose a new password"
msgstr "Elegir una contraseña nueva"

#: .\templates\account\email\password_reset.html:71
#, python-format
#| msgid ""
#| "The code expires in %(minutes)s minutes and can only be used once."
msgid "The link expires in %(minutes)s minutes and can only be used once."
msgstr "El enlace caduca en %(minutes)s minutos y solo se puede usar una vez."

#: .\templates\account\email\password_reset.html:74
msgid "If the button does not work, copy this address into your browser:"
msgstr "Si el botón no funciona, copia esta dirección en tu navegador:"

#: .\templates\account\email\password_reset.html:84
#, python-format
msgid ""
"If you did not ask for this, ignore this message: your password will not "
"change. Nobody at Propensiones® will ever ask you for this link. If you are "
"worried, write to %(contact_email)s."
msgstr ""
"Si no lo has pedido tú, ignora este mensaje: tu contraseña no cambiará. "
"Nadie de Propensiones® te pedirá nunca este enlace. Si te preocupa, escribe "
"a %(contact_email)s."

#: .\templates\account\email\password_reset.html:95
msgid ""
"This message was sent automatically. If you reply, it will reach our "
"management office."
msgstr ""
"Este mensaje se envió automáticamente. Si respondes, tu correo llegará a "
"nuestra dirección."

#: .\templates\account\forgot_password.html:35
msgid "Enter your email or username to receive password reset instructions."
msgstr ""
"Escribe tu correo o tu usuario para recibir las instrucciones para "
"restablecer tu contraseña."

#: .\templates\account\forgot_password.html:57
msgid "Send Reset Instructions"
msgstr "Enviar instrucciones"

#: .\templates\account\forgot_password.html:65
msgid ""
"Please enter your new password twice so we can verify you typed it in "
"correctly."
msgstr ""
"Escribe tu contraseña nueva dos veces para comprobar que la has tecleado "
"bien."

#: .\templates\account\forgot_password.html:116
#| msgid "Backup token"
msgid "Back to Login"
msgstr "Volver al acceso"

#: .\templates\account\layout\account.html:55
#: .\templates\account\layout\account.html:56
msgid "Switch between light and dark mode"
msgstr "Cambiar entre modo claro y oscuro"

#: .\templates\account\layout\account.html:63
msgid "Go to the home page"
msgstr "Ir a la página de inicio"

#: .\templates\account\login.html:19 .\templates\account\register.html:20
