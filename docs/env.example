# Copia este fichero a `.env` en la raiz del proyecto y rellena los valores.
# `app_core/env.py` comprueba al arrancar las variables que no tienen valor por
# defecto: si falta alguna, el error las nombra TODAS juntas (y cada una dice
# para que sirve). Las que llevan un valor por defecto en `settings.py` estan
# aqui para que se vean, no porque haga falta ponerlas.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=
# Clave Fernet: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# 'True' activa DEBUG. Cualquier otro valor lo desactiva y enciende HSTS,
# cookies seguras y redireccion a HTTPS.
DJANGO_DEBUG=False
# Uno solo, o varios separados por comas.
#
# **El `www` tiene que estar.** `RedirectWWWMiddleware` es quien manda el 301
# de `www.` a la direccion sin `www`, pero para llegar a ejecutarse el host ya
# tiene que estar permitido: `request.get_host()` lanza `DisallowedHost` antes,
# y la peticion muere con un 400. Con el CNAME de `www` puesto en la zona
# --que lo esta-- dejarlo fuera significa que quien teclee el `www` se
# encuentra un error en vez del sitio.
#
# Lo que **no** va aqui son los nombres de cPanel que apuntan a la misma IP
# (`mail.`, `webmail.`, `cpanel.`, `whm.`, `autodiscover.`, `webdisk.`,
# `ftp.`, `cpcalendars.`, `cpcontacts.`). No son de esta aplicacion, y que
# Django los rechace es lo correcto; el `DisallowedHost` que dejan en el log
# es ruido, no un fallo. Si estorba, se redirigen en el servidor web.
DJANGO_ALLOWED_HOSTS=propensionesabogados.com,www.propensionesabogados.com
# Con barra final y sin barra inicial. No lo dejes en 'admin/' en produccion.
DJANGO_ADMIN_URL=admin/

# --- Base de datos ----------------------------------------------------------
# Motor declarado. Con MySQL/MariaDB, `app_core/db/engine_for()` instala en su
# lugar `app_core.db.mysql`, que es el mismo con los UUID guardados como
# estaban. No pongas ese aqui a mano: ver `app_core/db/mysql/base.py`.
DB_ENGINE=django.db.backends.mysql
DB_CONN_MAX_AGE=60
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CHARSET=utf8mb4

# --- Ficheros ---------------------------------------------------------------
DJANGO_STATIC_ROOT=
DJANGO_MEDIA_ROOT=

# --- Correo -----------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_DEFAULT_FROM_EMAIL=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_PORT=587
# OJO: settings usa `bool(os.getenv(...))`, y en Python cualquier cadena no
# vacia es True --incluido 'False'. Para usar TLS deja esta variable VACIA.
DJANGO_EMAIL_USE_SSL=

# --- Seguridad --------------------------------------------------------------
# Origenes que pueden llamar a la API desde el navegador (CORS), separados por
# comas, CON esquema y sin barra final. Sin comodines de subdominio. Si no se
# define, o esta vacia, se usa esta misma lista (con y sin www). Solo se lee con
# DJANGO_DEBUG distinto de 'True': en desarrollo son localhost:3000 y
# 0.0.0.0:3000.
CORS_ALLOWED_ORIGINS=https://geausa.propensionesabogados.com,https://www.geausa.propensionesabogados.com,https://fundacionattlas.com,https://www.fundacionattlas.com,https://fundacionattlas.org,https://www.fundacionattlas.org
# Nombre del campo trampa de django-honeypot. Que no se parezca a uno real.
HONEYPOT_FIELD_NAME=
# Minutos que dura el bloqueo de una IP (`IPBlockedModel`).
IP_BLOCKED_TIME_IN_MINUTES=30
MIDDLEWARE_NOT_INCLUDE=
# Terminos separados por comas que delatan un escaneo.
COMMON_ATTACK_TERMS=wp-admin,wp-login,phpmyadmin,.env,xmlrpc.php
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# --- Acceso -----------------------------------------------------------------
# Minutos que vive el codigo de seis cifras que llega al correo.
LOGIN_OTP_TTL_MINUTES=15
# A quien escribir si a alguien le llega un codigo que no ha pedido. Esa es la
# senal de que otro esta intentando entrar en su cuenta.
OTP_CONTACT_EMAIL=info@propensionesabogados.com
# A donde contestan los correos de la cuenta cuando se le da a «responder».
ACCOUNT_REPLY_TO=info@propensionesabogados.com
# django-axes: intentos fallidos antes de frenar esa pareja (IP, usuario), y
# cuanto dura el freno. Los valores por defecto de la biblioteca son tres
# intentos y bloqueo PERMANENTE por IP: en un despacho que comparte salida a
# internet, eso deja fuera a todo el mundo. No los uses.
AXES_FAILURE_LIMIT=6
AXES_COOLOFF_MINUTES=30
# Ponla a cualquier valor SOLO si hay un proxy propio delante que reescriba
# `X-Forwarded-For`. Sin el, creerse esa cabecera deja que cada intento elija
# su identidad y se salte todos los contadores por IP.
USE_X_FORWARDED_FOR=

# --- Integraciones ----------------------------------------------------------
# Horas de validez del token de Attlas (settings lo pasa a segundos).
ATTLAS_TOKEN_TIMEOUT=24
# Clave servidor a servidor (minimo 32 caracteres en produccion): la MISMA en
# este .env, en el .env de gea y en Vercel (fundacionattlas.org). Sirve para
# la API de Attlas (X-Server-Key), para creer X-Client-IP y como clave del
# emisor ante gea. Las variables viejas ATTLAS_SERVER_KEY y
# GEA_ISSUER_KEY_PROPENSIONES se retirarán; por ahora se leen si falta esta y
# `manage.py check` avisa.
SERVER_KEY=
CHAT_GPT_API_KEY=
SOCRATA_API_KEY=
SOCRATA_API_KEY_SECRET=

# --- Paz y salvo certificado por gea ----------------------------------------
# Base de la API de gea, sin barra final. Por defecto (sin definir) es
# https://gea.propensionesabogados.com. Vacia = el paz y salvo se autoriza
# igual pero queda PENDING sin certificar (aviso de `manage.py check`).
GEA_CERT_API_BASE=https://gea.propensionesabogados.com
# Slug con que gea conoce a este emisor.
GEA_ISSUER_SLUG=propensiones
# La clave ante gea es SERVER_KEY (arriba): la misma en los dos .env. Rotarla
# en los dos lados a la vez.
# Timeouts en segundos y tope de intentos por documento.
GEA_CERT_CONNECT_TIMEOUT=5
GEA_CERT_READ_TIMEOUT=60
PAZ_Y_SALVO_MAX_ATTEMPTS=5
# Direccion publica del sitio: la usan los enlaces de los correos y, si no se
# define PAZ_Y_SALVO_PUBLIC_BASE, la URL del QR del paz y salvo. gea exige que
# el QR sea https.
PUBLIC_BASE_URL=https://propensionesabogados.com
PAZ_Y_SALVO_PUBLIC_BASE=
# Carpeta de los PDF del paz y salvo. Debe quedar FUERA de MEDIA_ROOT y sin
# que el servidor web la publique: solo salen por las vistas con permiso.
PRIVATE_MEDIA_ROOT=
